# Copia este archivo a `.env.local` y completa los valores. Nunca subas secretos al repo.

# --- Entorno local (`supabase start`) -------------------------------------------
# Las llaves locales se obtienen con `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo para jobs del servidor; nunca se expone al cliente.
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Producción (placeholders) ----------------------------------------------------
# El proyecto de Supabase en la nube se crea al final del sprint 2. Estos valores
# se configuran en las variables de entorno de Vercel, no en este archivo.
# SUPABASE_PROJECT_REF=<referencia-del-proyecto>
# NEXT_PUBLIC_SUPABASE_URL=https://<referencia-del-proyecto>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<llave-publicable>
# SUPABASE_SECRET_KEY=<llave-secreta>
# DATABASE_URL=postgresql://postgres.<referencia-del-proyecto>:<contraseña>@<host-del-pooler>:6543/postgres

# --- Cloudflare (solo para `scripts/cloudflare-zona.sh`) -------------------------
# Token con permisos Zone:Edit y DNS:Edit. El ID de cuenta aparece en la URL del panel.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# URL pública de cada app (enlaces de invitación y de regreso de Auth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_KIOSCO_URL=http://localhost:3001

# Entrada con Google: 1 para mostrar el botón (requiere configurar el proveedor en Supabase Auth).
NEXT_PUBLIC_GOOGLE_AUTH=

# Secreto con el que Vercel Cron llama a /api/cron/purga-fotos (solo producción).
CRON_SECRET=
